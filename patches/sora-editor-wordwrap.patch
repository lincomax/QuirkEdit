+package io.github.rosemoe.sora.text.breaker;
+
+import androidx.annotation.NonNull;
+
+import io.github.rosemoe.sora.text.ContentLine;
+
+/**
+ * Classic greedy line breaking, as Android's original StaticLayout did it:
+ * fill the row, then break at the last opportunity that fits. Opportunities are
+ * after a space or tab, after '-' or '/' (unless a digit follows), and after
+ * '.', ',', ':' or ';' (unless a digit is on either side). With no opportunity,
+ * the row breaks at the last character that fits.
+ */
+public class WordBreakerGreedy implements WordBreaker {
+
+    private final char[] chars;
+    private final int length;
+
+    public WordBreakerGreedy(@NonNull ContentLine text) {
+        this.chars = text.getBackingCharArray();
+        this.length = text.length();
+    }
+
+    @Override
+    public int getOptimizedBreakPoint(int start, int end) {
+        if (end >= length || end <= start) {
+            return end;
+        }
+        // The first character that doesn't fit is a space: break right here,
+        // the space hangs at the end of this row
+        if (chars[end] == ' ' || chars[end] == '\t') {
+            return end;
+        }
+        for (int k = end; k > start; k--) {
+            if (isBreakAfter(k - 1)) {
+                return k;
+            }
+        }
+        return end;
+    }
+
+    private boolean isBreakAfter(int i) {
+        char c = chars[i];
+        if (c == ' ' || c == '\t') {
+            return true;
+        }
+        boolean nextIsDigit = i + 1 < length && Character.isDigit(chars[i + 1]);
+        if (c == '-' || c == '/') {
+            return !nextIsDigit;
+        }
+        if (c == '.' || c == ',' || c == ':' || c == ';') {
+            boolean prevIsDigit = i > 0 && Character.isDigit(chars[i - 1]);
+            return !prevIsDigit && !nextIsDigit;
+        }
+        // CJK ideographs can break anywhere
+        return c >= 0x2E80 && Character.isIdeographic(c);
+    }
+}
